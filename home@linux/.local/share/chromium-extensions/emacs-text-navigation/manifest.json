{
  "manifest_version": 3,
  "name": "Emacs Text Navigation",
  "version": "1.0.0",
  "description": "Adds Emacs-style Ctrl navigation to editable text in Chromium.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["navigation.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
