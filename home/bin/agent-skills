#!/usr/bin/env ruby
# Installs and updates agent rules and skills for Claude Code and Codex.
# Replaces APM: rules come from ~/.apm/instructions, self-authored skills
# from the asonas plugin marketplace, third-party skills from `npx skills`,
# and two writing skills straight from their author's Gists.
require 'digest'
require 'fileutils'
require 'json'
require 'open3'
require 'tempfile'

HOME = Dir.home
WINDOWS = Gem.win_platform?
INSTRUCTIONS = File.join(HOME, '.apm/instructions')
CODEX_INSTRUCTIONS = File.join(HOME, '.apm/codex-instructions')

MARKETPLACE = { source: 'asonas/skills', name: 'asonas-skills', plugin: 'asonas@asonas-skills' }.freeze

# `npx skills add` arguments. Skills already provided by a Claude plugin
# (statechart comes with pstack) are installed for Codex only.
THIRD_PARTY = [
  { repo: 'mattpocock/skills', agents: %w[claude-code codex],
    skills: %w[ask-matt code-review codebase-design diagnosing-bugs domain-modeling grill-me grill-with-docs
               grilling handoff implement implement-spec improve-codebase-architecture pr prototype research
               retro setup-matt-pocock-skills tdd teach to-questionnaire to-spec to-tickets triage wait-what
               wayfinder wizard writing-for-agents] },
  { repo: 'emilkowalski/skills', agents: %w[claude-code codex],
    skills: %w[animate animate-expo animation-performance animation-vocabulary apple-design ask-sonner break-ui
               emil-design-eng find-animation-opportunities improve-animations mobile-native pick-ui-library
               review-animations write-swift] },
  { repo: 'yusukebe/ax', agents: %w[claude-code codex], skills: %w[ax] },
  { repo: 'herdrdev/herdr-core', agents: %w[claude-code codex], skills: %w[herdr-core] },
  { repo: 'shibayu36/agent-skills', agents: %w[claude-code codex], skills: %w[core-message-writing] },
  { repo: 'typesafe-ai/skills', agents: %w[codex], skills: %w[typesafe-ai] },
  { repo: 'dietrichgebert/ponytail', agents: %w[codex], skills: %w[ponytail] },
  { repo: 'cursor/plugins', agents: %w[codex], skills: %w[statechart] }
].freeze

APM_SERVICES = %w[apm-watch apm-instructions-watch].freeze

# Windows resolves npx, claude and codex through .cmd shims, which need cmd.exe.
def command(*args)
  WINDOWS ? ['cmd', '/c', *args] : args
end

def run!(*args, env: {})
  puts "+ #{args.join(' ')}"
  system(env, *command(*args)) || abort("Command failed: #{args.join(' ')}")
end

def capture(*args)
  stdout, _stderr, status = Open3.capture3(*command(*args))
  status.success? ? stdout : ''
end

def replace_file(path, content)
  FileUtils.mkdir_p(File.dirname(path))
  Tempfile.create('.agent-skills-', File.dirname(path)) do |file|
    file.write(content)
    file.chmod(0o644)
    file.close
    File.rename(file.path, path)
  end
end

def body(path)
  File.read(path).sub(/\A---\r?\n.*?\r?\n---\r?\n/m, '').sub(/\A\s+/, '')
end

# Claude reads one rule file per source; Codex reads a single AGENTS.md.
def rules
  sources = Dir.glob(File.join(INSTRUCTIONS, '*.instructions.md')).sort
  abort "No instructions found in #{INSTRUCTIONS}" if sources.empty?
  sources.each do |path|
    name = File.basename(path, '.instructions.md')
    replace_file(File.join(HOME, '.claude/rules', "#{name}.md"), body(path))
  end

  codex = (sources + Dir.glob(File.join(CODEX_INSTRUCTIONS, '*.instructions.md'))).sort_by { |path| File.basename(path) }
  sections = codex.map do |path|
    label = "#{File.basename(File.dirname(path))}/#{File.basename(path)}"
    "<!-- Source: #{label} -->\n#{body(path).chomp}\n<!-- End source: #{label} -->\n"
  end
  header = "# AGENTS.md\n<!-- Generated by ~/bin/agent-skills from ~/.apm/instructions and ~/.apm/codex-instructions. Do not edit manually. -->\n\n## Global Instructions\n\n"
  replace_file(File.join(HOME, '.codex/AGENTS.md'), header + sections.join("\n"))
  puts "Rules written for #{sources.size} sources"
end

# Removes what APM deployed, using APM's own receipts, so that `npx skills`
# does not collide with APM-owned directories. Files edited since deployment
# are kept. Safe to run repeatedly and on machines where APM is already gone.
def retire
  # Once synced config no longer declares these services, `services status`
  # stops listing them, but their LaunchAgent or unit stays installed until
  # removed by name. Removing one that is already gone just fails.
  APM_SERVICES.each do |name|
    output = capture('mise', 'bootstrap', 'services', 'remove', name)
    puts output.lines.first if output.include?('removed')
  end

  receipts = Dir.glob(File.join(HOME, '.apm/deployment-receipts/*.json'))
  return puts('No APM receipts to retire') if receipts.empty?

  receipts.each do |receipt|
    data = JSON.parse(File.read(receipt))
    removed = kept = 0
    data.fetch('records').each do |record|
      key = [record['target'], record['runtime'].to_s, record['scope'], record['value']].join('|')
      path = data.fetch('destinations')[key]
      next unless path.is_a?(String) && File.file?(path) && !File.symlink?(path)

      if "sha256:#{Digest::SHA256.file(path).hexdigest}" == record['content_hash']
        File.delete(path)
        removed += 1
        prune_empty_dirs(File.dirname(path))
      else
        warn "Keeping modified APM file: #{path}"
        kept += 1
      end
    end
    retired = File.join(HOME, '.apm/retired-receipts')
    FileUtils.mkdir_p(retired)
    FileUtils.mv(receipt, File.join(retired, File.basename(receipt)))
    puts "Retired #{File.basename(receipt)}: removed #{removed} files, kept #{kept} modified"
  end
end

def prune_empty_dirs(dir)
  stops = %w[.claude/skills .agents/skills .cursor/skills .codex/skills].map { |root| File.join(HOME, root) }
  while dir.start_with?(HOME) && !stops.include?(dir) && Dir.exist?(dir) && Dir.empty?(dir)
    Dir.rmdir(dir)
    dir = File.dirname(dir)
  end
end

def plugins(update:)
  claude_markets = capture('claude', 'plugin', 'marketplace', 'list')
  run!('claude', 'plugin', 'marketplace', 'add', MARKETPLACE[:source]) unless claude_markets.include?(MARKETPLACE[:name])
  if capture('claude', 'plugin', 'list').include?(MARKETPLACE[:plugin])
    if update
      run!('claude', 'plugin', 'marketplace', 'update', MARKETPLACE[:name])
      run!('claude', 'plugin', 'update', MARKETPLACE[:plugin])
    end
  else
    run!('claude', 'plugin', 'install', MARKETPLACE[:plugin])
  end

  codex_markets = capture('codex', 'plugin', 'marketplace', 'list')
  if codex_markets.include?(MARKETPLACE[:name])
    run!('codex', 'plugin', 'marketplace', 'upgrade', MARKETPLACE[:name]) if update
  else
    run!('codex', 'plugin', 'marketplace', 'add', MARKETPLACE[:source])
  end
  # Reinstalling is what refreshes the Codex plugin cache; its version stays 1.0.0.
  run!('codex', 'plugin', 'add', MARKETPLACE[:plugin])
end

NPX_ENV = { 'DISABLE_TELEMETRY' => '1' }.freeze

def third_party(only: nil)
  THIRD_PARTY.each do |entry|
    next if only && entry[:repo] != only

    args = ['npx', '--yes', 'skills', 'add', entry[:repo], '--global', '--yes']
    entry[:agents].each { |agent| args.push('--agent', agent) }
    entry[:skills].each { |skill| args.push('--skill', skill) }
    run!(*args, env: NPX_ENV)
  end
end

def gists
  run!(RbConfig.ruby, File.join(HOME, 'bin/install_gist_skills'), HOME)
end

case ARGV.shift
when 'rules' then rules
when 'retire' then retire
when 'third-party' then third_party(only: ARGV.first)
when 'gists' then gists
when 'install'
  retire
  rules
  plugins(update: false)
  third_party
  gists
when 'update'
  plugins(update: true)
  run!('npx', '--yes', 'skills', 'update', '--global', '--yes', env: NPX_ENV)
  gists
  rules
else
  abort 'usage: agent-skills rules|retire|third-party [repo]|gists|install|update'
end
