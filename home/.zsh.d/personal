export PATH="$HOME/.local/bin:$PATH"
PYTORCH_CUDA_ALLOC_CONF=garbage_collection_threshold:0.6,max_split_size_mb:128
export PATH="$HOME/crystal/bin:$PATH"
source "$HOME/.rye/env"
export JAVA_HOME=/usr/lib/jvm/java-22-openjdk
export PATH=$JAVA_HOME/bin:$PATH

export PNPM_HOME="/home/asonas/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# gnome-keyring-daemon for envchain (CLI-only environment)
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus
if [ ! -f ~/.local/share/keyrings/login.keyring ]; then
  printf '\0' | gnome-keyring-daemon --login --components=secrets >/dev/null 2>&1
fi
printf '\0' | gnome-keyring-daemon --unlock --components=secrets >/dev/null 2>&1
