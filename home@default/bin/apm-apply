#!/usr/bin/env ruby
require 'fileutils'
require 'digest'
require 'json'
require 'rbconfig'
require 'tempfile'
require 'tmpdir'
require 'yaml'

root = Dir.home
source = File.join(root, '.apm')
script = File.expand_path(__FILE__)
log = File.join(source, 'auto-apply.log')

def run!(*command, **options)
  system(*command, **options) || abort("Command failed: #{command.join(' ')}")
end

def replace_file(destination, content)
  FileUtils.mkdir_p(File.dirname(destination))
  Tempfile.create('.apm-', File.dirname(destination)) do |file|
    file.write(content)
    file.chmod(0644)
    file.close
    File.rename(file.path, destination)
  end
end

def watch!(source, log, script, *arguments)
  $stdout.reopen(log, 'a')
  $stderr.reopen($stdout)
  $stdout.sync = true
  Dir.chdir(source)
  exec 'watchexec', *arguments, '--shell=none', '--', RbConfig.ruby, script,
       *yield
end

def compile_instructions!(root, source)
  Dir.mktmpdir('apm-instructions-') do |directory|
    FileUtils.mkdir_p(File.join(directory, '.apm'))
    FileUtils.cp_r(File.join(source, 'instructions'), File.join(directory, '.apm/instructions'))
    # Codex-only instructions live outside ~/.apm/instructions so that
    # `apm install` does not deploy them to ~/.claude/rules/.
    Dir.glob(File.join(source, 'codex-instructions', '*.instructions.md')).each do |path|
      FileUtils.cp(path, File.join(directory, '.apm/instructions'))
    end
    File.write(File.join(directory, 'apm.yml'), "name: asonas-global-instructions\nversion: 1.0.0\ndependencies:\n  apm: []\n")
    # Claude reads these instructions from ~/.claude/rules/, which `apm install`
    # deploys. Compiling CLAUDE.md as well would load them twice.
    run! 'apm', 'compile', '--local-only', '--single-agents', '--force-instructions',
         '--target', 'codex', chdir: directory

    compiled = File.join(directory, 'AGENTS.md')
    abort('Missing compiled AGENTS.md') unless File.size?(compiled)
    replace_file(File.join(root, '.codex/AGENTS.md'), File.read(compiled))
  end
  remove_generated_claude_md!(root)
end

def remove_generated_claude_md!(root)
  path = File.join(root, '.claude/CLAUDE.md')
  return unless File.file?(path) && !File.symlink?(path)
  return unless File.foreach(path).first(3).any? { |line| line.include?('<!-- Generated by APM CLI -->') }

  File.delete(path)
  puts "Removed generated #{path}"
end

SKILL_PATHS = %w[.agents/skills .claude/skills .cursor/skills .apm/.claude/skills .apm/.agents/skills].freeze

def skill_fingerprint(path)
  return nil if File.symlink?(path) || !File.directory?(path)

  entries = Dir.glob('**/*', File::FNM_DOTMATCH, base: path).reject do |entry|
    entry.split('/').include?('.apm-pin')
  end.sort
  return nil unless entries.include?('SKILL.md')

  Digest::SHA256.hexdigest(entries.map do |entry|
    full = File.join(path, entry)
    if File.symlink?(full)
      [entry, 'link', File.readlink(full)]
    elsif File.file?(full)
      [entry, 'file', Digest::SHA256.file(full).hexdigest]
    else
      [entry, 'directory']
    end
  end.to_json)
end

def skill_locations(root, name)
  (SKILL_PATHS.map { |base| File.join(base, name) } +
    [File.join('.apm/apm_modules/asonas/skills', name)]).to_h do |relative|
    [relative, skill_fingerprint(File.join(root, relative))]
  end.compact
end

def prune_retired_skills!(root, source)
  manifest = YAML.safe_load_file(File.join(source, 'apm.yml'))
  entries = manifest.fetch('dependencies').fetch('apm')
  active = entries.filter_map do |entry|
    if entry.is_a?(Hash) && entry['git'] == 'asonas/skills'
      entry['path']
    elsif entry.is_a?(String) && entry.start_with?('asonas/skills/')
      entry.delete_prefix('asonas/skills/')
    end
  end
  declared = entries.filter_map do |entry|
    entry['path'] if entry.is_a?(Hash)
  end + entries.filter_map do |entry|
    entry.split('/').last if entry.is_a?(String)
  end
  state_path = File.join(source, 'managed-asonas-skills.json')
  previous = if File.file?(state_path)
               JSON.parse(File.read(state_path))
             else
               cache = File.join(source, 'apm_modules/asonas/skills')
               Dir.children(cache).to_h do |name|
                 cached = skill_fingerprint(File.join(cache, name))
                 locations = cached ? skill_locations(root, name).select { |_, hash| hash == cached } : {}
                 [name, locations]
               end.reject { |_, locations| locations.empty? } if File.directory?(cache)
             end || {}

  remaining = {}
  previous.each do |name, locations|
    next if active.include?(name)
    next remaining[name] = locations if declared.include?(name)
    next unless /\A[a-z0-9]+(?:-[a-z0-9]+)*\z/.match?(name)

    locations.each do |relative, fingerprint|
      next unless (SKILL_PATHS + ['.apm/apm_modules/asonas/skills']).any? { |base| relative == File.join(base, name) }
      path = File.join(root, relative)
      next unless File.exist?(path) || File.symlink?(path)
      if skill_fingerprint(path) == fingerprint
        FileUtils.rm_rf(path)
        puts "Removed retired APM skill: #{path}"
      else
        warn "Keeping modified retired APM skill: #{path}"
        (remaining[name] ||= {})[relative] = fingerprint
      end
    end
  end
  active.each { |name| remaining[name] = skill_locations(root, name) }
  replace_file(state_path, JSON.pretty_generate(remaining) + "\n")
end

def deploy_local_skills!(root, source)
  skill = File.join(source, 'local-skills/herdr-agent-launch/SKILL.md')
  return unless File.file?(skill)

  %w[.agents/skills .claude/skills].each do |relative|
    destination = File.join(root, relative, 'herdr-agent-launch')
    abort("Refusing symlink skill directory: #{destination}") if File.symlink?(destination)
    replace_file(File.join(destination, 'SKILL.md'), File.read(skill))
  end
end

# APM 0.35.0 binds each deployment receipt to the root's [st_dev, st_ino]. The
# device number of the same home directory changes across reboots on macOS and
# btrfs, so every later install fails with "installation binding does not
# match" (microsoft/apm#3421). APM's suggested recovery, deleting the receipt,
# makes the next update delete unedited skill files (microsoft/apm#3422).
# Rebind a receipt only when everything but st_dev still matches and no
# recorded file was modified. Remove this once an APM release includes
# microsoft/apm#3439 and a reboot no longer breaks the binding.
def rebind_deployment_receipts!(home, source)
  Dir.glob(File.join(source, 'deployment-receipts', '*.json')).sort.each do |path|
    next if File.symlink?(path) || !File.file?(path)

    text = File.read(path)
    data = JSON.parse(text)
    root = data['root']
    identity = data['root_identity']
    next unless data['version'] == 1 && root.is_a?(String) && data['scope'].is_a?(String)
    next unless identity.is_a?(Array) && identity.size == 2 && identity.all?(Integer)
    next unless File.basename(path, '.json') == Digest::SHA256.hexdigest("#{root}|#{data['scope']}")
    next if File.symlink?(root) || !File.directory?(root)

    stat = File.stat(root)
    current = [stat.dev, stat.ino]
    next if identity == current

    refusal = receipt_rebind_refusal(data, root, stat)
    next warn("Keeping APM receipt #{path}: #{refusal}") if refusal

    updated = text.sub(/("root_identity": \[\s*)#{identity[0]}(,\s*#{identity[1]}\s*\])/) do
      "#{Regexp.last_match(1)}#{stat.dev}#{Regexp.last_match(2)}"
    end
    unless JSON.parse(updated) == data.merge('root_identity' => current)
      next warn("Keeping APM receipt #{path}: could not rewrite root_identity alone")
    end

    backups = File.join(source, 'receipt-backups')
    FileUtils.mkdir_p(backups, mode: 0o700)
    FileUtils.cp(path, File.join(backups, File.basename(path)), preserve: true)
    Tempfile.create('.receipt-', File.dirname(path)) do |file|
      file.write(updated)
      file.chmod(0o600)
      file.close
      File.rename(file.path, path)
    end
    puts "Rebound APM receipt #{path}: st_dev #{identity[0]} -> #{stat.dev} (microsoft/apm#3421)"
  rescue JSON::ParserError, SystemCallError => e
    warn "Keeping APM receipt #{path}: #{e.message}"
  end
end

def receipt_rebind_refusal(data, root, stat)
  return 'root inode changed' unless data['root_identity'][1] == stat.ino

  installation = File.join(root, '.apm-local/installation')
  return 'installation identity missing' if File.symlink?(installation) || !File.file?(installation)
  return 'installation identity differs' unless File.read(installation).strip == data['installation']

  records = data['records']
  destinations = data['destinations']
  return 'malformed records' unless records.is_a?(Array) && destinations.is_a?(Hash)

  # A missing file has nothing left to protect; prune_retired_skills! removes
  # skills outside APM, and APM cannot retire them while the binding is broken.
  modified = records.filter_map do |record|
    key = [record['target'], record['runtime'].to_s, record['scope'], record['value']].join('|')
    destination = destinations[key]
    return "no destination recorded for #{key}" unless destination.is_a?(String)
    next unless File.file?(destination)

    destination unless "sha256:#{Digest::SHA256.file(destination).hexdigest}" == record['content_hash']
  end
  "modified since deployment: #{modified.first(5).join(', ')}" unless modified.empty?
end

case ARGV.first
when '--watch-manifest'
  watch!(source, log, script,
         '--postpone', '--debounce', '2s', '--on-busy-update', 'queue',
         '--no-discover-ignore', '--project-origin', source,
         '--watch-non-recursive', source, '--filter', '/apm.yml') { [] }
when '--watch-instructions'
  watch!(source, log, script,
         '--postpone', '--debounce', '2s', '--on-busy-update', 'queue',
         '--no-discover-ignore', '--project-origin', source,
         '--watch', File.join(source, 'instructions'), '--filter', '/instructions/**',
         '--watch', File.join(source, 'codex-instructions'), '--filter', '/codex-instructions/**') do
    ['--compile-only']
  end
when nil
  File.open(File.join(source, '.auto-apply.lock'), File::RDWR | File::CREAT, 0600) do |lock|
    lock.flock(File::LOCK_EX)
    run! RbConfig.ruby, File.join(root, 'bin/install_gist_skills'), root,
         RbConfig.ruby, script, '--apply'
  end
when '--compile-only'
  File.open(File.join(source, '.auto-apply.lock'), File::RDWR | File::CREAT, 0600) do |lock|
    lock.flock(File::LOCK_EX)
    compile_instructions!(root, source)
    puts "APM instructions compiled at #{Time.now.utc}"
  end
when '--rebind-receipts'
  File.open(File.join(source, '.auto-apply.lock'), File::RDWR | File::CREAT, 0600) do |lock|
    lock.flock(File::LOCK_EX)
    rebind_deployment_receipts!(root, source)
  end
when '--apply'
  # The caller already holds .auto-apply.lock; taking it again would deadlock.
  rebind_deployment_receipts!(root, source)
  begin
    run! 'apm', 'install', '--global', '--only', 'apm', '--target', 'claude,cursor,codex', chdir: source
    prune_retired_skills!(root, source)
  ensure
    # APM injects Claude-only bootstrap hooks; retain the user's Herdr-only policy.
    settings_path = File.join(root, '.claude/settings.json')
    if File.file?(settings_path)
      settings = JSON.parse(File.read(settings_path))
      hooks = settings['hooks'] ||= {}
      hooks.delete('sessionStart')
      sessions = hooks.fetch('SessionStart', []).filter_map do |entry|
        kept = entry.fetch('hooks', []).reject do |hook|
          hook.fetch('command', '').match?(%r{superpowers/|herdr-agent-state\.sh})
        end
        entry.merge('hooks' => kept) unless kept.empty?
      end
      hooks['SessionStart'] = sessions
      if File.file?(File.join(root, '.claude/hooks/herdr-agent-state.sh'))
        hooks['SessionStart'] << {'matcher' => 'startup|resume|clear|compact', 'hooks' => [
          {'type' => 'command', 'command' => '"$HOME/.claude/hooks/herdr-agent-state.sh" session'}
        ]}
      end
      replace_file(settings_path, JSON.pretty_generate(settings) + "\n")
    end
    run! RbConfig.ruby, File.join(root, 'bin/fix_agent_frontmatter'), File.join(root, '.claude/agents/security-reviewer.md')
    run! 'sh', File.join(root, 'bin/fix_codex_agent_description'), File.join(root, '.codex/agents/security-reviewer.toml')
  end
  deploy_local_skills!(root, source)
  compile_instructions!(root, source)
  puts "APM configuration applied at #{Time.now.utc}"
else
  abort 'usage: apm-apply [--watch-manifest|--watch-instructions|--compile-only]'
end
