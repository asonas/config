#!/usr/bin/env bash
#
# herdr-fork-codex-session [direction]
#
# Fork the current Codex CLI session into a new Herdr pane.
# Companion to herdr-fork-claude-session (see gist:
# https://gist.github.com/miyagawa/cb1a9f6c8695d1219efba0c66d5f78f7), adapted
# for Codex.
#
#   direction   right (default) | down  -- which way to split off the new pane
#
# Two hosts are supported:
#   - Legacy herdr TUI (HERDR_ENV=1, HERDR_PANE_ID set): the session id is looked
#     up from Herdr's own bookkeeping (populated via Codex's SessionStart hook)
#     for THIS pane, identified by HERDR_PANE_ID -- not "focused", which tracks
#     UI focus and can point at a different pane than the one running this
#     script.
#   - Herdr.app on herdr-core (HC_TERMINAL_ID set and `herdr-app` available):
#     the session id comes from CODEX_THREAD_ID, which Codex sets for the
#     commands it runs. The split targets the pane holding this terminal
#     (found by HC_TERMINAL_ID). The fork runs with --no-daemon, which herdr-core
#     requires so that Codex's commands stay inside hc.
# Needs python3 for JSON.
set -euo pipefail

name=herdr-fork-codex-session

validate_direction() {
    case "$direction" in
        right | down) ;;
        *)
            echo "$name: direction must be 'right' or 'down', got '$direction'" >&2
            exit 1
            ;;
    esac
}

fork_legacy_herdr() {
    if [ -z "${HERDR_PANE_ID:-}" ]; then
        echo "$name: HERDR_PANE_ID is not set" >&2
        exit 1
    fi

    if ! sid=$(herdr agent list |
        python3 -c "
import sys, json, os
agents = json.load(sys.stdin)['result']['agents']
pane_id = os.environ.get('HERDR_PANE_ID')
mine = [a for a in agents if a.get('pane_id') == pane_id]
if not mine:
    sys.exit('could not find this pane in herdr agent list')
a = mine[0]
if a.get('agent') != 'codex':
    sys.exit(\"this pane's agent is '%s', not codex\" % a.get('agent'))
print(a['agent_session']['value'])
"); then
        echo "$name: could not resolve this pane's Codex session id" >&2
        exit 1
    fi

    direction="${1:-right}"
    validate_direction

    pane=$(herdr pane split --current --direction "$direction" --cwd "$PWD" --no-focus |
        python3 -c "import sys, json; print(json.load(sys.stdin)['result']['pane']['pane_id'])")

    herdr pane run "$pane" "codex fork $sid"
    echo "forked session $sid -> pane $pane"
}

fork_herdr_app() {
    sid="${CODEX_THREAD_ID:-}"
    if [ -z "$sid" ]; then
        echo "$name: CODEX_THREAD_ID is not set; run this from a command inside the Codex session" >&2
        exit 1
    fi

    direction="${1:-right}"
    validate_direction

    if ! codex_bin=$(command -v codex); then
        echo "$name: codex is not on PATH" >&2
        exit 1
    fi

    # The pane that holds this terminal, not whichever pane has focus.
    if ! pane=$(herdr-app ls | python3 -c "
import sys, json, os
me = os.environ['HC_TERMINAL_ID']
hits = [t['pane'] for s in json.load(sys.stdin).get('spaces', [])
        for tab in s.get('tabs', []) for t in tab.get('terminals', [])
        if t.get('terminal') == me]
if len(hits) != 1:
    sys.exit('terminal %s appears %d times in herdr-app ls' % (me, len(hits)))
print(hits[0])
"); then
        echo "$name: could not find the pane holding terminal $HC_TERMINAL_ID" >&2
        exit 1
    fi

    # pane.split has no folder argument, so cd explicitly. PATH is passed so
    # the new terminal resolves the same tools as this shell.
    argv=$(python3 -c "
import json, sys
print(json.dumps(['/usr/bin/env', 'PATH=' + sys.argv[1], 'sh', '-c',
                  'cd \"\$1\" && exec \"\$2\" --no-daemon fork \"\$3\"',
                  'sh', sys.argv[2], sys.argv[3], sys.argv[4]]))
" "$PATH" "$PWD" "$codex_bin" "$sid")

    if ! result=$(herdr-app do pane.split --direction "$direction" --pane "$pane" --argv "$argv"); then
        echo "$name: herdr-app pane.split failed: $result" >&2
        exit 1
    fi
    new=$(printf '%s' "$result" | python3 -c "
import sys, json
r = json.load(sys.stdin)
if 'error' in r:
    sys.exit(r['error'])
print('%s (terminal %s)' % (r.get('pane'), r.get('terminal')))
")
    echo "forked session $sid -> pane $new"
}

if [ "${HERDR_ENV:-}" = "1" ]; then
    fork_legacy_herdr "$@"
elif [ -n "${HC_TERMINAL_ID:-}" ] && command -v herdr-app >/dev/null 2>&1; then
    fork_herdr_app "$@"
elif [ -n "${HC_TERMINAL_ID:-}" ]; then
    echo "$name: running under herdr-core (HC_TERMINAL_ID=$HC_TERMINAL_ID) but herdr-app is not available on this machine" >&2
    exit 1
else
    echo "$name: not running inside Herdr (HERDR_ENV != 1 and HC_TERMINAL_ID unset)" >&2
    exit 1
fi
